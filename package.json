{
  "name": "readiness",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply readiness --local",
    "db:migrate:remote": "wrangler d1 migrations apply readiness --remote",
    "db:seed-demo": "node scripts/seed-demo.mjs > .seed-demo.sql && wrangler d1 execute readiness --local --file=.seed-demo.sql",
    "check": "astro check",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "astro": "^7.4.12",
    "chart.js": "^4.6.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true,
    "workerd@1.20261113.1": true
  }
}
