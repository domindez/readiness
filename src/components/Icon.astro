---
import { ICONS, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  stroke?: number;
  class?: string;
}
const { name, size = 20, stroke = 1.9, class: cls } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"><path d={ICONS[name]}></path></svg
>
